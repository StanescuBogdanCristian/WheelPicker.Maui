<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:Sample.ViewModels"
             xmlns:views="clr-namespace:Sample.SampleViews"
             xmlns:wp="http://schemas.sbc.com/maui/wheelpicker"
             x:Class="Sample.Views.SamplesPage"
             Title="Samples of real use cases">

    <ContentPage.BindingContext>
        <models:SamplesPageViewModel />
    </ContentPage.BindingContext>
    <ScrollView Padding="10">
        <VerticalStackLayout MaximumWidthRequest="500"
                             Spacing="10">

            <toolkit:Expander x:Name="timerExpander">
                <toolkit:Expander.Header>
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                            StrokeThickness="0"
                            Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,auto">
                            <Label Text="Timer"
                                   VerticalTextAlignment="Center"
                                   FontSize="Medium" />
                            <Image Grid.Column="1">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xe5c5;"
                                                     FontFamily="MaterialIcons"
                                                     Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                </Image.Source>
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image"
                                                 Binding="{Binding Source={x:Reference timerExpander}, Path=IsExpanded}"
                                                 Value="True">
                                        <Setter Property="RotationX"
                                                Value="180" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                        </Grid>
                    </Border>
                </toolkit:Expander.Header>
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                        StrokeThickness="0"
                        TranslationY="-8"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,8,8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <BoxView HeightRequest="1"
                                 Opacity=".3" />
                        <Grid ColumnDefinitions="*,auto,*,auto,*"
                              RowDefinitions="auto,*"
                              ColumnSpacing="10"
                              RowSpacing="10"
                              HorizontalOptions="Center"
                              VerticalOptions="Start">
                            <Label Text="Hours"
                                   VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="Center"
                                   Margin="3,0"
                                   Grid.Row="0"
                                   Grid.Column="0" />
                            <wp:WheelPicker x:Name="WheelPickerHours"
                                            ItemsSource="{Binding HoursItems}"
                                            SelectedIndex="{Binding Hours, Mode=TwoWay}"
                                            IsSwipeEnabled="{Binding IsNotRunning}"
                                            CurvatureFactor="0"
                                            Grid.Row="1"
                                            Grid.Column="0">
                                <wp:WheelPicker.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding ., StringFormat='{0:D2}'}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               FontSize="35"
                                               FontFamily="RobotoRegular">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Source={x:Reference WheelPickerHours}, Path=IsSpinning}"
                                                             Value="True">
                                                    <Setter Property="TextColor"
                                                            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </DataTemplate>
                                </wp:WheelPicker.ItemTemplate>
                                <wp:WheelPicker.Overlay>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="{Binding Source={x:Reference WheelPickerHours}, Path=ItemHeight}" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <BoxView Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                                                 BackgroundColor="{OnPlatform Android=Transparent,Default={AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}}"
                                                 Opacity="0.8"
                                                 Grid.Row="0" />

                                        <BoxView Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                                                 BackgroundColor="{OnPlatform Android=Transparent,Default={AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}}"
                                                 Opacity="0.8"
                                                 Grid.Row="2" />
                                    </Grid>
                                </wp:WheelPicker.Overlay>
                            </wp:WheelPicker>

                            <Label Text=":"
                                   VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="Center"
                                   FontSize="35"
                                   Grid.Row="1"
                                   Grid.Column="1" />

                            <Label Text="Minutes"
                                   VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="Center"
                                   Grid.Row="0"
                                   Grid.Column="2" />
                            <wp:WheelPicker x:Name="WheelPickerMinutes"
                                            ItemsSource="{Binding MinutesItems}"
                                            SelectedIndex="{Binding Minutes, Mode=TwoWay}"
                                            IsSwipeEnabled="{Binding IsNotRunning}"
                                            CurvatureFactor="0"
                                            Grid.Row="1"
                                            Grid.Column="2">
                                <wp:WheelPicker.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding ., StringFormat='{0:D2}'}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               FontSize="35"
                                               FontFamily="RobotoRegular">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Source={x:Reference WheelPickerMinutes}, Path=IsSpinning}"
                                                             Value="True">
                                                    <Setter Property="TextColor"
                                                            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </DataTemplate>
                                </wp:WheelPicker.ItemTemplate>
                                <wp:WheelPicker.Overlay>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="{Binding Source={x:Reference WheelPickerMinutes}, Path=ItemHeight}" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <BoxView Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                                                 BackgroundColor="{OnPlatform Android=Transparent,Default={AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}}"
                                                 Opacity="0.8"
                                                 Grid.Row="0" />

                                        <BoxView Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                                                 BackgroundColor="{OnPlatform Android=Transparent,Default={AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}}"
                                                 Opacity="0.8"
                                                 Grid.Row="2" />
                                    </Grid>
                                </wp:WheelPicker.Overlay>
                            </wp:WheelPicker>

                            <Label Text=":"
                                   VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="Center"
                                   FontSize="35"
                                   Grid.Row="1"
                                   Grid.Column="3" />

                            <Label Text="Seconds"
                                   VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="Center"
                                   Grid.Row="0"
                                   Grid.Column="4" />
                            <wp:WheelPicker x:Name="WheelPickerSeconds"
                                            ItemsSource="{Binding SecondsItems}"
                                            SelectedIndex="{Binding Seconds, Mode=TwoWay}"
                                            IsSwipeEnabled="{Binding IsNotRunning}"
                                            CurvatureFactor="0"
                                            Grid.Row="1"
                                            Grid.Column="4">
                                <wp:WheelPicker.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding ., StringFormat='{0:D2}'}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               FontSize="35"
                                               FontFamily="RobotoRegular">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Source={x:Reference WheelPickerSeconds}, Path=IsSpinning}"
                                                             Value="True">
                                                    <Setter Property="TextColor"
                                                            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </DataTemplate>
                                </wp:WheelPicker.ItemTemplate>
                                <wp:WheelPicker.Overlay>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="{Binding Source={x:Reference WheelPickerSeconds}, Path=ItemHeight}" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <BoxView Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                                                 BackgroundColor="{OnPlatform Android=Transparent,Default={AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}}"
                                                 Opacity="0.8"
                                                 Grid.Row="0" />

                                        <BoxView Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                                                 BackgroundColor="{OnPlatform Android=Transparent,Default={AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}}"
                                                 Opacity="0.8"
                                                 Grid.Row="2" />
                                    </Grid>
                                </wp:WheelPicker.Overlay>
                            </wp:WheelPicker>
                        </Grid>

                        <HorizontalStackLayout Spacing="12"
                                               HorizontalOptions="Center">

                            <Button Text="Start"
                                    Command="{Binding StartCommand}" />

                            <Button Text="Pause"
                                    Command="{Binding PauseCommand}" />

                            <Button Text="Reset"
                                    Command="{Binding ResetCommand}" />

                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </toolkit:Expander>

            <toolkit:Expander x:Name="dateExpander">
                <toolkit:Expander.Header>
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                            StrokeThickness="0"
                            Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,auto">
                            <Label Text="Date picker"
                                   VerticalTextAlignment="Center"
                                   FontSize="Medium" />
                            <Image Grid.Column="1">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xe5c5;"
                                                     FontFamily="MaterialIcons"
                                                     Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                </Image.Source>
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image"
                                                 Binding="{Binding Source={x:Reference dateExpander}, Path=IsExpanded}"
                                                 Value="True">
                                        <Setter Property="RotationX"
                                                Value="180" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                        </Grid>
                    </Border>
                </toolkit:Expander.Header>
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                        StrokeThickness="0"
                        TranslationY="-8"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,8,8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <BoxView HeightRequest="1"
                                 Opacity=".3" />
                        
                        <views:DatePicker />
                    </VerticalStackLayout>
                </Border>
            </toolkit:Expander>

            <toolkit:Expander x:Name="timeExpander">
                <toolkit:Expander.Header>
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                            StrokeThickness="0"
                            Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,auto">
                            <Label Text="Time picker"
                                   VerticalTextAlignment="Center"
                                   FontSize="Medium" />
                            <Image Grid.Column="1">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xe5c5;"
                                                     FontFamily="MaterialIcons"
                                                     Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                </Image.Source>
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image"
                                                 Binding="{Binding Source={x:Reference timeExpander}, Path=IsExpanded}"
                                                 Value="True">
                                        <Setter Property="RotationX"
                                                Value="180" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                        </Grid>
                    </Border>
                </toolkit:Expander.Header>
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                        StrokeThickness="0"
                        TranslationY="-8"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,8,8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <BoxView HeightRequest="1"
                                 Opacity=".3" />
                        
                        <views:TimePicker />
                    </VerticalStackLayout>
                </Border>
            </toolkit:Expander>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>