<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Sample.ViewModels"
             xmlns:wp="http://schemas.sbc.com/maui/wheelpicker"
             x:Class="Sample.Views.PropertiesPage"
             x:Name="root"
             Title="Properties and their default values">

    <ContentPage.BindingContext>
        <models:PropertiesPageViewModel />
    </ContentPage.BindingContext>

    <Grid ColumnDefinitions="auto,1,*"
          RowDefinitions="auto,*"
          IsClippedToBounds="True"
          RowSpacing="0">
        <ScrollView Grid.Column="0"
                    Grid.Row="1">
            <VerticalStackLayout Spacing="0"
                                 Padding="10">
                <Label Text="Selections"
                       FontAttributes="Bold" />
                <Grid ColumnDefinitions="auto,*"
                      RowDefinitions="auto,auto,auto,auto"
                      RowSpacing="3">
                    <Label Text="SelectedItem"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="0"
                           Grid.Column="0" />
                    <Picker FontSize="12"
                            ItemsSource="{Binding Years}"
                            SelectedItem="{Binding SelectedYear}"
                            Margin="0,0,0,5"
                            Grid.Row="0"
                            Grid.Column="1" />
                    <Label Text="SelectedIndex"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="1"
                           Grid.Column="0" />
                    <Picker FontSize="12"
                            ItemsSource="{Binding YearIndexes}"
                            SelectedItem="{Binding SelectedYearIndex}"
                            Grid.Row="1"
                            Grid.Column="1" />
                    <Label Text="IsSelectionAnimated"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="2"
                           Grid.Column="0" />
                    <Switch IsToggled="{Binding Source={x:Reference wheelPicker}, Path=IsSelectionAnimated}"
                            VerticalOptions="Center"
                            HorizontalOptions="End"
                            Grid.Row="2"
                            Grid.Column="1" />
                    <Grid ColumnDefinitions="*,auto"
                          RowDefinitions="auto,auto"
                          Grid.Row="3"
                          Grid.Column="0"
                          Grid.ColumnSpan="2">
                        <Label Text="SelectionThreshold"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2" />
                        <Slider Value="{Binding Source={x:Reference wheelPicker}, Path=SelectionThreshold}"
                                Grid.Row="1"
                                Grid.Column="0" />
                        <Label Text="{Binding Source={x:Reference wheelPicker}, Path=SelectionThreshold, StringFormat='{0:F2}'}"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="End"
                               Grid.Row="1"
                               Grid.Column="1" />
                    </Grid>
                </Grid>
                <BoxView HeightRequest="1"
                         Margin="0,5"
                         Opacity=".3" />

                <Label Text="Feedbacks"
                       FontAttributes="Bold" />
                <Grid ColumnDefinitions="auto,*"
                      RowDefinitions="auto,auto"
                      RowSpacing="3">
                    <Label Text="HapticFeedback"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="0"
                           Grid.Column="0" />
                    <Switch IsToggled="{Binding Source={x:Reference wheelPicker}, Path=HapticFeedback}"
                            VerticalOptions="Center"
                            HorizontalOptions="End"
                            Grid.Row="0"
                            Grid.Column="1" />
                    <Label Text="SoundFeedback"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="1"
                           Grid.Column="0" />
                    <Switch IsToggled="{Binding Source={x:Reference wheelPicker}, Path=SoundFeedback}"
                            VerticalOptions="Center"
                            HorizontalOptions="End"
                            Grid.Row="1"
                            Grid.Column="1" />
                </Grid>
                <BoxView HeightRequest="1"
                         Margin="0,5"
                         Opacity=".3" />

                <Label Text="Interaction"
                       FontAttributes="Bold" />
                <Grid ColumnDefinitions="auto,*"
                      RowDefinitions="auto,auto"
                      RowSpacing="3">
                    <Label Text="Loop"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="0"
                           Grid.Column="0" />
                    <Switch IsToggled="{Binding Source={x:Reference wheelPicker}, Path=Loop}"
                            VerticalOptions="Center"
                            HorizontalOptions="End"
                            Grid.Row="0"
                            Grid.Column="1" />
                    <Label Text="IsSwipeEnabled"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="1"
                           Grid.Column="0" />
                    <Switch IsToggled="{Binding Source={x:Reference wheelPicker}, Path=IsSwipeEnabled}"
                            VerticalOptions="Center"
                            HorizontalOptions="End"
                            Grid.Row="1"
                            Grid.Column="1" />
                </Grid>
                <BoxView HeightRequest="1"
                         Margin="0,5"
                         Opacity=".3" />

                <Label Text="Appearance"
                       FontAttributes="Bold"
                       Margin="0,0,0,5" />
                <Grid ColumnDefinitions="*,auto"
                      RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto, auto,auto">
                    <Label Text="VisibleItemsCount"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="2" />
                    <Slider x:Name="visibleItemsCountSlider"
                            ValueChanged="OnVisibleItemsCountSliderValueChanged"
                            Minimum="1"
                            Maximum="11"
                            Grid.Row="1"
                            Grid.Column="0" />
                    <Label Text="{Binding Source={x:Reference wheelPicker}, Path=VisibleItemsCount, StringFormat='{0}'}"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           Grid.Row="1"
                           Grid.Column="1" />

                    <Label Text="CurvatureFactor"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="2" />
                    <Slider Value="{Binding Source={x:Reference wheelPicker}, Path=CurvatureFactor}"
                            Grid.Row="3"
                            Grid.Column="0" />
                    <Label Text="{Binding Source={x:Reference wheelPicker}, Path=CurvatureFactor, StringFormat='{0:F2}'}"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           Grid.Row="3"
                           Grid.Column="1" />

                    <Label Text="EdgeItemTiltAngle"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="4"
                           Grid.Column="0"
                           Grid.ColumnSpan="2" />
                    <Slider x:Name="edgeItemTiltAngleSlider"
                            ValueChanged="OnEdgeItemTiltAngleSliderValueChanged"
                            Minimum="0"
                            Maximum="90"
                            Grid.Row="5"
                            Grid.Column="0" />
                    <Label Text="{Binding Source={x:Reference wheelPicker}, Path=EdgeItemTiltAngle, StringFormat='{0:F2}°'}"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           Grid.Row="5"
                           Grid.Column="1" />

                    <Label Text="EdgeItemScale"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="6"
                           Grid.Column="0"
                           Grid.ColumnSpan="2" />
                    <Slider Value="{Binding Source={x:Reference wheelPicker}, Path=EdgeItemScale}"
                            Grid.Row="7"
                            Grid.Column="0" />
                    <Label Text="{Binding Source={x:Reference wheelPicker}, Path=EdgeItemScale, StringFormat='{0:F2}'}"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           Grid.Row="7"
                           Grid.Column="1" />

                    <Label Text="EdgeItemOpacity"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="8"
                           Grid.Column="0"
                           Grid.ColumnSpan="2" />
                    <Slider Value="{Binding Source={x:Reference wheelPicker}, Path=EdgeItemOpacity}"
                            Grid.Row="9"
                            Grid.Column="0" />
                    <Label Text="{Binding Source={x:Reference wheelPicker}, Path=EdgeItemOpacity, StringFormat='{0:F2}'}"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           Grid.Row="9"
                           Grid.Column="1" />
                </Grid>

                <BoxView HeightRequest="1"
                         Margin="0,5"
                         Opacity=".3" />

                <Label Text="Fling &amp; Inertia"
                       FontAttributes="Bold"
                       Margin="0,0,0,5" />
                <Grid ColumnDefinitions="*,auto"
                      RowDefinitions="auto,auto,auto,auto,auto,auto">
                    <Label Text="FlingVelocityThreshold"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="2" />
                    <Slider x:Name="flingVelocitySlider"
                            ValueChanged="OnFlingVelocitySliderValueChanged"
                            Minimum="0"
                            Maximum="1500"
                            Grid.Row="1"
                            Grid.Column="0" />
                    <Label Text="{Binding Source={x:Reference wheelPicker}, Path=FlingVelocityThreshold, StringFormat='{0:F2}'}"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           Grid.Row="1"
                           Grid.Column="1" />

                    <Label Text="InertiaMinVelocity"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="2" />
                    <Slider x:Name="inertiaMinVelocitySlider"
                            Minimum="0"
                            Maximum="100"
                            ValueChanged="OnInertiaMinVelocityValueChanged"
                            Grid.Row="3" />
                    <Label Text="{Binding Source={x:Reference wheelPicker}, Path=InertiaMinVelocity, StringFormat='{0:F2}'}"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           Grid.Row="3"
                           Grid.Column="1" />

                    <Label Text="InertiaDeceleration"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="4"
                           Grid.Column="0"
                           Grid.ColumnSpan="2" />
                    <Slider x:Name="inertiaDecelerationSlider"
                            Minimum="500"
                            Maximum="3000"
                            ValueChanged="OnInertiaDecelerationValueChanged"
                            Grid.Row="5" />
                    <Label Text="{Binding Source={x:Reference wheelPicker}, Path=InertiaDeceleration, StringFormat='{0:F2}'}"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           Grid.Row="5"
                           Grid.Column="1" />
                </Grid>
                <BoxView HeightRequest="1"
                         Margin="0,5"
                         Opacity=".3" />

                <Label Text="Readonly"
                       FontAttributes="Bold"
                       Margin="0,0,0,5" />
                <Grid ColumnDefinitions="auto,*"
                      RowDefinitions="auto,auto,auto"
                      RowSpacing="3">

                    <Label Text="IsDragging"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="0"
                           Grid.Column="0" />

                    <Label Text="{Binding Source={x:Reference wheelPicker}, Path=IsDragging}"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           Grid.Row="0"
                           Grid.Column="1" />

                    <Label Text="IsSpinning"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="1"
                           Grid.Column="0" />
                    <Label Text="{Binding Source={x:Reference wheelPicker}, Path=IsSpinning}"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           Grid.Row="1"
                           Grid.Column="1" />

                    <Label Text="ItemHeight"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           Grid.Row="2"
                           Grid.Column="0" />
                    <Label Text="{Binding Source={x:Reference wheelPicker}, Path=ItemHeight, StringFormat='{0:F2}'}"
                           FontSize="12"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           Grid.Row="2"
                           Grid.Column="1" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <BoxView Opacity=".3"
                 Grid.Column="1"
                 Grid.Row="1"
                 Margin="0,10" />
        <wp:WheelPicker x:Name="wheelPicker"
                        ItemsSource="{Binding Years}"
                        SelectedItem="{Binding SelectedYear}"
                        SelectedIndex="{Binding SelectedYearIndex}"
                        Grid.Column="2"
                        Grid.Row="1">
            <wp:WheelPicker.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}"
                           FontFamily="RobotoRegular"
                           VerticalTextAlignment="Center"
                           HorizontalOptions="Center"
                           MaximumHeightRequest="40"
                           FontSize="25" />
                </DataTemplate>
            </wp:WheelPicker.ItemTemplate>
        </wp:WheelPicker>
    </Grid>
</ContentPage>